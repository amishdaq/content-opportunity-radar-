    {
      "parameters": {
        "jsCode": "const sentNews = $('Get row(s) in sheet1').all()\n  .map(item => item.json)\n  .filter(row => row.user_id && row.news_link);\n\nconst sentSet = new Set(\n  sentNews.map(row => `${row.user_id}_${row.news_link}`)\n);\n\nconst newsItems = $('Code in JavaScript').all();\n\nconst newItems = newsItems.filter(item => {\n  const key = `${item.json.user_id}_${item.json.link}`;\n  return !sentSet.has(key);\n});\n\nreturn newItems;"
      },
